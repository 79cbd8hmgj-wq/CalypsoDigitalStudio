---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
interface Props{title:string;description:string;image?:string}
const{title,description,image='/assets/brand/calypso-master.webp'}=Astro.props;
const fullTitle=title==='Calypso Digital Studio' ? 'Calypso Digital Studio | Web Design & Development in Albany, NY' : `${title} | Calypso Digital Studio`;
const canonicalUrl = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', 'https://calypsodigital.us').href;
const socialImageUrl = new URL(image, 'https://calypsodigital.us').href;
const isAffordablePage = Astro.url.pathname.replace(/\\/$/, '') === '/affordable-web-design';
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Calypso Digital Studio',
  url: 'https://calypsodigital.us/',
  description: 'Calypso Digital Studio designs websites, builds practical custom business software, creates workflow automations and provides website repair and support for small businesses.',
  makesOffer: [
    ...['Website design and development', 'Custom business software', 'Workflow automation and integrations', 'Website repair and technical support'].map((name) => ({
      '@type': 'Offer',
      name,
      itemOffered: { '@type': 'Service', name }
    })),
    ...(isAffordablePage ? [{
      '@type': 'Offer',
      name: 'Basic one-page website production',
      description: 'Production of a basic one-page informational website. Extra pages, advanced functionality, content creation, hosting, domains, subscriptions and third-party charges are separate.',
      price: '89.99',
      priceCurrency: 'USD',
      itemOffered: { '@type': 'Service', name: 'One-page website design and production' }
    }] : [])
  ],
  image: socialImageUrl,
  areaServed: [
    { '@type': 'Place', name: 'Capital Region, New York' },
    { '@type': 'Place', name: 'Albany, New York' },
    { '@type': 'Place', name: 'Troy, New York' }
  ],
  founder: { '@type': 'Person', name: 'Evan Lebrecht' },
  knowsAbout: ['Website design', 'Website development', 'Website repair', 'Workflow automation', 'API integrations', 'Custom business software']
};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="robots" content="index, follow, max-image-preview:large"/><link rel="canonical" href={canonicalUrl}/><meta property="og:site_name" content="Calypso Digital Studio"/><meta property="og:url" content={canonicalUrl}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImageUrl}/><meta name="theme-color" content="#F7F1E7"/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={socialImageUrl}/><script type="application/ld+json" set:html={JSON.stringify(businessSchema)}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="manifest" href="/site.webmanifest"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet"/><title>{fullTitle}</title></head><body><a class="skip-link" href="#main-content">Skip to content</a><SiteHeader/><main id="main-content"><slot/></main><SiteFooter/></body></html>
<style is:global>.skip-link{position:fixed;z-index:100;top:.5rem;left:.5rem;transform:translateY(-150%);border-radius:var(--radius-small);background:var(--color-ink);color:var(--color-surface);padding:.75rem 1rem}.skip-link:focus{transform:translateY(0)}</style>
