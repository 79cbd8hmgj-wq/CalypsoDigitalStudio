---
import { wizardSteps } from '../../data/intake';
---
<nav class="wizard-progress" aria-label="Project form progress">
  <p class="wizard-progress__current" aria-live="polite" data-progress-current>{`Step 1 of ${wizardSteps.length}: ${wizardSteps[0]?.label ?? 'Your Business'}`}</p>
  <ol>
    {wizardSteps.map((step) => (
      <li>
        <button
          type="button"
          data-progress-step={step.index}
          aria-current={step.index === 0 ? 'step' : undefined}
          disabled={step.index !== 0}
        >
          <span>{step.index + 1}</span>
          {step.label}
        </button>
      </li>
    ))}
  </ol>
</nav>
