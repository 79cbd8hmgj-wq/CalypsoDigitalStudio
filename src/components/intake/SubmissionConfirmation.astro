<section class="submission-confirmation surface" data-submission-confirmation hidden tabindex="-1" aria-labelledby="confirmation-title">
  <p class="eyebrow">Request received</p>
  <h2 id="confirmation-title">Your project details have been received.</h2>
  <p data-confirmation-message>
    Calypso Digital Studio will review the information and respond within two to three business days. No price has been generated, and submitting this request does not commit you to purchasing services. A copy of the submission has been sent to your email.
  </p>
  <dl>
    <div><dt>Reference</dt><dd data-confirmation-reference></dd></div>
    <div><dt>Email</dt><dd data-confirmation-email></dd></div>
    <div><dt>Expected response</dt><dd>Within two to three business days</dd></div>
  </dl>
  <p>Corrections or questions: <a href="mailto:calydigital@outlook.com">calydigital@outlook.com</a></p>
  <div class="button-row">
    <a class="button button--secondary" href="/">Return to the website</a>
    <button class="button" type="button" data-new-request>Start a Different Project</button>
  </div>
</section>
