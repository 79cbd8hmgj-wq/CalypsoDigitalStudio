---
interface Props{title:string;summary:string;projectType:string;status:'live'|'in-progress';image:string}
const{title,summary,projectType,status,image}=Astro.props;
---
<article class="project-card surface"><div class="image"><img src={image} alt={`${title} mobile website preview`} width="1242" height="2250" loading="lazy"/></div><div class="content"><p class="eyebrow">{projectType}{status==='in-progress'&&' · In progress'}</p><h3>{title}</h3><p>{summary}</p></div></article>
<style>.project-card{display:grid;overflow:hidden}.image{max-height:28rem;overflow:hidden;background:var(--color-lavender)}.image img{width:100%;height:100%;object-fit:cover;object-position:top}.content{padding:var(--space-5)}</style>
