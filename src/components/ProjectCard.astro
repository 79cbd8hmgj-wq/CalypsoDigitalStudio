---
interface Props{title:string;summary:string;projectType:string;status:'live'|'in-progress';image?:string}
const{title,summary,projectType,status,image}=Astro.props;
---
<article class="project-card surface"><div class="image">{image?<img src={image} alt={`${title} mobile website preview`} width="1242" height="2250" loading="lazy"/>:<div class="project-identity"><span>NugNav</span><small>Find better cannabis for less.</small></div>}</div><div class="content"><p class="eyebrow">{projectType}{status==='in-progress'&&' · In progress'}</p><h3>{title}</h3><p>{summary}</p></div></article>
<style>.project-card{display:grid;overflow:hidden}.image{max-height:28rem;overflow:hidden;background:var(--color-lavender)}.image img{width:100%;height:100%;object-fit:cover;object-position:top}.project-identity{min-height:18rem;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;padding:2rem;text-align:center;background:#173f32;color:#f5f0e3}.project-identity span{font-size:clamp(2rem,5vw,3rem);font-weight:800;letter-spacing:-.04em}.project-identity small{font-size:1rem}.content{padding:var(--space-5)}</style>
