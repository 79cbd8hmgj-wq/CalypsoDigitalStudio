---
import BaseLayout from '../layouts/BaseLayout.astro';import PageIntro from '../components/PageIntro.astro';import {projectTypes} from '../data/intake';
---
<BaseLayout title="Start Your Project" description="Choose the type of website or digital tool your business may need and prepare for a project conversation."><PageIntro eyebrow="Start your project" title="Begin with the option closest to what the business needs." description="You do not need to know the exact pages, platform, or technical solution before reaching out."/><section class="types container">{projectTypes.map(([title,description])=><article class="surface"><h2>{title}</h2><p>{description}</p></article>)}</section><section class="note container"><div><p class="eyebrow">What the full guided form will cover</p><h2>Business goals, pages, features, materials, visual direction, budget, and timeframe.</h2><p>Submitting the finished form will not commit you to purchasing services. It will help me understand the project and prepare an accurate recommendation.</p></div><aside class="surface"><h2>Ready to discuss it now?</h2><p>Until the guided form is activated, send the project details through the Calypso Digital Studio Instagram account.</p><a class="text-link" href="https://www.instagram.com/calypsodigitalstudio/">Message Calypso Digital Studio on Instagram</a></aside></section></BaseLayout><style>.types{display:grid;gap:var(--space-4)}.types article,.note aside{padding:var(--space-5)}.note{display:grid;gap:var(--space-5);padding-block:var(--space-8)}@media(min-width:48rem){.types{grid-template-columns:repeat(2,minmax(0,1fr))}.note{grid-template-columns:1.2fr .8fr}}</style>
