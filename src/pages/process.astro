---
import BaseLayout from '../layouts/BaseLayout.astro';import PageIntro from '../components/PageIntro.astro';import ButtonLink from '../components/ButtonLink.astro';import {processSteps} from '../data/process';
---
<BaseLayout title="Process" description="See how a Calypso Digital Studio project moves from inquiry through launch."><PageIntro eyebrow="Process" title="A clear path for clients who have never hired a web designer before." description="You will know what happens next, what I need from you, and what is being reviewed at each stage."/><ol class="timeline container">{processSteps.map(([title,description],i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h2>{title}</h2><p>{description}</p></div></li>)}</ol><section class="cta container surface"><h2>The first step is not a commitment.</h2><p>Your project details help me understand the business and prepare the right recommendation before either side agrees to a build.</p><ButtonLink href="/start">Start Your Project</ButtonLink></section></BaseLayout><style>.timeline{margin-block:0 var(--space-8);padding:0;list-style:none}.timeline li{display:grid;grid-template-columns:3.5rem 1fr;gap:var(--space-4);border-top:var(--border-thin);padding-block:var(--space-6)}.timeline span{color:var(--color-rust);font-family:var(--font-display);font-size:var(--step-2);font-weight:700}.cta{margin-block:var(--space-8);padding:var(--space-6)}</style>
