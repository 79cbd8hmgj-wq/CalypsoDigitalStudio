---
import BaseLayout from '../layouts/BaseLayout.astro';import PageIntro from '../components/PageIntro.astro';import ButtonLink from '../components/ButtonLink.astro';import {services} from '../data/services';
---
<BaseLayout title="Services" description="Website design, redesigns, e-commerce, custom business tools, and ongoing support from Calypso Digital Studio."><PageIntro eyebrow="Services" title="The right build depends on what the business needs to accomplish." description="You do not need to know the technical name for every feature. Start with the customer experience, the current problem, and the result you need."/><section class="list container">{services.map((s,i)=><article id={s.title==='Custom business tools'?'custom-tools':undefined}><span>{String(i+1).padStart(2,'0')}</span><div><h2>{s.title}</h2><p>{s.summary}</p><ul>{s.examples.map((e)=><li>{e}</li>)}</ul></div></article>)}</section><section class="cta container surface"><h2>Not sure which category fits?</h2><p>Describe the business and the goal. I will recommend the most practical route.</p><ButtonLink href="/start">Start Your Project</ButtonLink></section></BaseLayout><style>.list article{display:grid;grid-template-columns:3.25rem 1fr;gap:var(--space-4);border-top:2px solid var(--color-ink);padding-block:var(--space-6)}.list article>span{color:var(--color-rust);font-family:var(--font-display);font-size:var(--step-2)}.list ul{display:flex;flex-wrap:wrap;gap:var(--space-2);padding:0;list-style:none}.list li{border:var(--border-thin);border-radius:999px;padding:.35rem .7rem;font-size:var(--step--1)}.cta{margin-block:var(--space-7);padding:var(--space-6)}</style>
