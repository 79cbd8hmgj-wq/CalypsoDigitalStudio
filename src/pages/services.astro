---
import BaseLayout from '../layouts/BaseLayout.astro';import PageIntro from '../components/PageIntro.astro';import ButtonLink from '../components/ButtonLink.astro';import {services} from '../data/services';
---
<BaseLayout title="Services" description="Custom website design, redesigns, e-commerce and development with a price-beat guarantee on equivalent written quotes from independent web designers."><PageIntro eyebrow="Services" title="The right build depends on what the business needs to accomplish." description="Start with the customer experience, the current problem, and the result you need. The studio will help identify the right technical approach."/><section class="list container">{services.map((s,i)=><article id={s.title==='Custom business tools'?'custom-tools':undefined}><span>{String(i+1).padStart(2,'0')}</span><div><h2>{s.title}</h2><p>{s.summary}</p><ul>{s.examples.map((e)=><li>{e}</li>)}</ul></div></article>)}</section><section class="price-guarantee container surface" id="price-guarantee"><p class="eyebrow">Lowest independent web design price guarantee</p><h2>Bring an independent web designer’s quote. We’ll beat their price.</h2><p>Have a lower written quote for the website you want? Calypso Digital Studio will offer a lower project price for equivalent web design and development work. We compare like-for-like deliverables, so the lower price doesn’t come from quietly cutting the agreed scope.</p><h3>How our price-beat guarantee works</h3><ol><li>Share a current, written, itemized quote from another independent web designer.</li><li>We compare the included pages, functionality, revisions, and deliverables against your project.</li><li>For a qualifying equivalent scope, we provide a written quote below the comparable website project price.</li></ol><p class="guarantee-terms">Applies to comparable website design and development services quoted by independent designers. Domain names, hosting, subscription fees, and other third-party charges are evaluated separately. The original quote must be verifiable and cover an equivalent scope.</p><ButtonLink href="/start">Get a Price-Beating Quote</ButtonLink></section><section class="cta container surface"><h2>Not sure which category fits?</h2><p>Describe the business and the goal. Calypso Digital Studio will recommend the most practical option.</p><ButtonLink href="/start">Start Your Project</ButtonLink></section></BaseLayout><style>.list article{display:grid;grid-template-columns:3.25rem 1fr;gap:var(--space-4);border-top:2px solid var(--color-ink);padding-block:var(--space-6)}.list article>span{color:var(--color-rust);font-family:var(--font-display);font-size:var(--step-2)}.list ul{display:flex;flex-wrap:wrap;gap:var(--space-2);padding:0;list-style:none}.list li{border:var(--border-thin);border-radius:999px;padding:.35rem .7rem;font-size:var(--step--1)}.price-guarantee{margin-block:var(--space-7);padding:var(--space-6);scroll-margin-top:var(--space-7)}.price-guarantee h2{max-width:22ch}.price-guarantee ol{padding-left:1.5rem}.price-guarantee li{margin-bottom:var(--space-2)}.guarantee-terms{font-size:var(--step--1);max-width:76ch}.cta{margin-block:var(--space-7);padding:var(--space-6)}</style>
