---
import {getCollection,render} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
const projectOrder=new Map([['lrl-photography',0],['rare-treats-518',1],['good-intentions',2]]);
const projects=(await getCollection('projects')).sort((a,b)=>(projectOrder.get(a.data.slug)??99)-(projectOrder.get(b.data.slug)??99));
const caseStudies=await Promise.all(projects.map(async (project)=>({project,Content:(await render(project)).Content})));
---
<BaseLayout title="Small Business Website Design Portfolio" description="Explore Calypso Digital Studio website design projects for a photographer, local treats business and clothing storefront. See project goals, features and development status.">
  <PageIntro eyebrow="Small-business website design portfolio" title="Real website projects for different small-business needs." description="Explore the design decisions, functionality and current status behind three Calypso Digital Studio projects."/>
  <section class="work-list container" aria-label="Website project case studies">
    {caseStudies.map(({project:p,Content},i)=>
      <section class="entry" aria-labelledby={`project-${p.data.slug}`}>
        <div class="project-visual">
          <ProjectCard title={p.data.title} summary={p.data.summary} projectType={p.data.projectType} status={p.data.status} image={i%2===0?p.data.primaryImage:p.data.secondaryImage}/>
        </div>
        <div class="details">
          <h2 id={`project-${p.data.slug}`}>{p.data.title} website project</h2>
          <p class="eyebrow">{p.data.status==='live'?'Live project':'In-progress project'}</p>
          <div class="case-study"><Content/></div>
          <h3>Project features</h3>
          <ul>{p.data.focus.map((x)=><li>{x}</li>)}</ul>
          {p.data.liveUrl&&<a class="text-link" href={p.data.liveUrl} target="_blank" rel="noopener noreferrer">Visit the live website</a>}
        </div>
      </section>
    )}
  </section>
  <section class="work-cta container surface" aria-labelledby="work-cta-heading">
    <p class="eyebrow">Website design for your business</p>
    <h2 id="work-cta-heading">Need a website with a clear purpose and a practical budget?</h2>
    <p>Basic one-page website production starts at $89.99. Larger projects are quoted by scope. Our qualifying price-beat guarantee applies to comparable independent web designer production quotes, excluding hosting, domains and third-party costs.</p>
    <p><a class="text-link" href="/affordable-web-design">Explore affordable website design and pricing</a></p>
    <p><a class="text-link" href="/services">Explore website design services</a></p>
    <p><a class="text-link" href="/start">Request a website quote</a></p>
  </section>
</BaseLayout>
<style>
  .work-list{display:grid;gap:var(--space-8)}
  .entry{display:grid;gap:var(--space-5);align-items:start}
  .details{padding:var(--space-4)}
  .details h2{font-size:var(--step-2)}
  .details ul{padding-left:1.2rem}
  .case-study{margin-block:var(--space-4)}
  .work-cta{margin-block:var(--space-8);padding:var(--space-6)}
  @media(min-width:52rem){.entry{grid-template-columns:minmax(0,1fr) minmax(18rem,.8fr)}.entry:nth-child(even)>.project-visual{order:2}}
</style>
