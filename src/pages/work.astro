---
import {getCollection,render} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
const projectOrder=new Map([['lrl-photography',0],['rare-treats-518',1],['nugnav',2],['good-intentions',3]]);
const projects=(await getCollection('projects')).sort((a,b)=>(projectOrder.get(a.data.slug)??99)-(projectOrder.get(b.data.slug)??99));
const caseStudies=await Promise.all(projects.map(async (project)=>({project,Content:(await render(project)).Content})));
---
<BaseLayout title="Websites and Custom Software Portfolio" description="Explore Calypso Digital Studio projects, including small-business websites and the NugNav custom web application with location-based search and price comparisons.">
  <PageIntro eyebrow="Websites and software portfolio" title="Practical digital work for different business needs." description="Explore customer-facing websites, an evolving custom web application, and the real development decisions behind each project."/>
  <section class="work-list container" aria-label="Website and software project case studies">
    {caseStudies.map(({project:p,Content},i)=>
      <section class="entry" id={`project-${p.data.slug}`} aria-labelledby={`project-heading-${p.data.slug}`}>
        <div class="project-visual">
          <ProjectCard title={p.data.title} summary={p.data.summary} projectType={p.data.projectType} status={p.data.status} image={i%2===0?(p.data.primaryImage??p.data.secondaryImage):(p.data.secondaryImage??p.data.primaryImage)}/>
        </div>
        <div class="details">
          <h2 id={`project-heading-${p.data.slug}`}>{p.data.title} project</h2>
          <p class="eyebrow">{p.data.status==='live'?'Live project':'In-progress project'}</p>
          <div class="case-study"><Content/></div>
          <h3>Project features</h3>
          <ul>{p.data.focus.map((x)=><li>{x}</li>)}</ul>
          {p.data.liveUrl&&<a class="text-link" href={p.data.liveUrl} target="_blank" rel="noopener noreferrer">Visit the live website</a>}
        </div>
      </section>
    )}
  </section>
  <section class="work-cta container surface" aria-labelledby="work-cta-heading">
    <p class="eyebrow">Build around the problem</p>
    <h2 id="work-cta-heading">Need a website, a custom tool, or technical help?</h2>
    <p>From straightforward business websites to custom workflows and repairs, the right solution starts with a defined goal and a clear scope.</p>
    <p><a class="text-link" href="/business-software">Explore custom software and automation</a></p>
    <p><a class="text-link" href="/website-support">Explore technical repairs and improvements</a></p>
    <p><a class="text-link" href="/affordable-web-design">Explore affordable website design</a></p>
    <p><a class="text-link" href="/start">Discuss a project</a></p>
  </section>
</BaseLayout>
<style>
  .work-list{display:grid;gap:var(--space-8)}
  .entry{display:grid;gap:var(--space-5);align-items:start;scroll-margin-top:var(--space-5)}
  .details{padding:var(--space-4)}
  .details h2{font-size:var(--step-2)}
  .details ul{padding-left:1.2rem}
  .case-study{margin-block:var(--space-4)}
  .work-cta{margin-block:var(--space-8);padding:var(--space-6)}
  @media(min-width:52rem){.entry{grid-template-columns:minmax(0,1fr) minmax(18rem,.8fr)}.entry:nth-child(even)>.project-visual{order:2}}
</style>
