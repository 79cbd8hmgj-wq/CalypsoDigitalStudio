---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {services} from '../data/services';
import {processSteps} from '../data/process';
const projectOrder=new Map([['lrl-photography',0],['rare-treats-518',1],['nugnav',2],['good-intentions',3]]);
const projects=(await getCollection('projects')).filter((p)=>p.data.featured).sort((a,b)=>(projectOrder.get(a.data.slug)??99)-(projectOrder.get(b.data.slug)??99));
---
<BaseLayout title="Calypso Digital Studio" description="Custom websites, business software, workflow automation and website technical support for small businesses in Albany, Troy and beyond."><section class="hero container"><div><p class="eyebrow">Websites · Custom software · Business automation</p><h1>Websites and software that make your business work better.</h1><p class="lede">From customer-facing websites to internal dashboards, workflow automations, and technical fixes, Calypso Digital Studio builds practical digital solutions for businesses in the Capital Region and beyond.</p><p class="pricing-note">Need a simple, affordable website? <a href="/affordable-web-design">Explore our entry-level website offer and pricing.</a></p><div class="actions"><ButtonLink href="/start">Discuss Your Project</ButtonLink><ButtonLink href="/business-software" variant="secondary">Explore Custom Software</ButtonLink></div></div><div class="board" aria-label="Selected Calypso Digital Studio projects"><figure class="shot one"><img src="/assets/projects/lrl-photography/portfolio-mobile.webp" alt="LRL Photography portfolio page preview" width="1242" height="2250"/><figcaption>Service website</figcaption></figure><figure class="shot two"><img src="/assets/projects/rare-treats-518/home-mobile.webp" alt="Rare Treats 518 homepage preview" width="1242" height="2250"/><figcaption>Consumer brand</figcaption></figure><div class="tool"><strong>Beyond websites</strong><span>Dashboards, client portals, integrations, forms, and purpose-built software.</span></div></div></section><section class="services container"><p class="eyebrow">What the studio builds</p><h2>More than web design. Find the help your business needs.</h2><div class="service-grid">{services.slice(0,4).map((s,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{s.title}</h3><p>{s.summary}</p><a class="text-link" href={s.href}>Explore this service</a></article>)}</div></section><section class="work container"><p class="eyebrow">Selected work</p><h2>From small-business websites to custom applications.</h2><div class="work-grid">{projects.map((p)=><ProjectCard title={p.data.title} summary={p.data.summary} projectType={p.data.projectType} status={p.data.status} image={p.data.primaryImage}/>)}</div><p>NugNav demonstrates location-based search, structured data and custom comparison workflows. <a class="text-link" href="/work#project-nugnav">See the custom application case study</a> or <a class="text-link" href="/work">browse all projects</a>.</p></section><section class="tools"><div class="container"><p class="eyebrow">Beyond the website</p><h2>Need a tool that fits how your business operates?</h2><p>Custom business software can bring information together, reduce repeated manual tasks, and give customers or staff a better way to work. Start with one problem and build only what is useful.</p><a class="text-link" href="/business-software">Explore business software and automation</a></div></section><section class="quick-help container" aria-labelledby="quick-help-title"><div class="surface"><p class="eyebrow">Website repairs and ongoing help</p><h2 id="quick-help-title">Already have a website that needs attention?</h2><p>Broken contact forms, awkward mobile layouts, slow pages, technical SEO, and deployment issues do not always require a rebuild.</p><a class="text-link" href="/website-support">See website repair and technical support options</a></div></section><section class="process container"><p class="eyebrow">How projects move</p><h2>A clear process from the first inquiry through launch.</h2><ol>{processSteps.slice(0,4).map(([title,description],i)=><li><span>{i+1}</span><div><h3>{title}</h3><p>{description}</p></div></li>)}</ol><a class="text-link" href="/process">See the complete process</a></section><section class="intake container"><div class="surface"><p class="eyebrow">Start with what you know</p><h2>You can begin without planning every detail of the project.</h2><p>The guided project form helps describe your business, goals, software or website needs, and next steps.</p><ButtonLink href="/start">Start Your Project</ButtonLink></div></section></BaseLayout>
<style>.hero{display:grid;gap:var(--space-7);align-items:center;padding-block:var(--space-8)}.lede{font-size:var(--step-1)}.pricing-note{margin-top:var(--space-4);max-width:56ch;font-size:var(--step--1);line-height:1.6;color:var(--color-ink)}.pricing-note strong{font-weight:800}.pricing-note a{font-weight:800;text-underline-offset:.2em}.actions{display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-5)}.board{position:relative;min-height:37rem;border:var(--border-thin);border-radius:var(--radius-large);background:linear-gradient(135deg,rgb(229 178 158 / .75),rgb(216 214 234 / .72));overflow:hidden}.shot{position:absolute;width:min(56%,15rem);margin:0;overflow:hidden;border:.5rem solid var(--color-surface);border-radius:var(--radius-medium);background:var(--color-surface);box-shadow:var(--shadow-soft)}.shot img{aspect-ratio:.62;width:100%;object-fit:cover;object-position:top}.shot figcaption{padding:.55rem .7rem;font-size:var(--step--1);font-weight:800}.one{top:2rem;left:1.5rem;transform:rotate(-3deg)}.two{top:6rem;right:1.25rem;transform:rotate(3deg)}.tool{position:absolute;right:1.5rem;bottom:1.5rem;left:1.5rem;display:grid;gap:.25rem;border-radius:var(--radius-small);background:var(--color-ink);color:var(--color-canvas);padding:var(--space-4)}.services,.work,.process,.intake{padding-block:var(--space-8)}.service-grid,.work-grid{display:grid;gap:var(--space-4)}.service-grid article{border-top:2px solid var(--color-ink);padding-block:var(--space-5)}.service-grid span{color:var(--color-rust);font-weight:800}.tools{background:var(--color-ink);color:var(--color-canvas)}.tools .container{padding-block:var(--space-8)}.tools .eyebrow{color:var(--color-clay)}.process ol{margin:0 0 var(--space-5);padding:0;list-style:none}.process li{display:grid;grid-template-columns:2.5rem 1fr;gap:var(--space-4);border-top:var(--border-thin);padding-block:var(--space-5)}.process li>span{color:var(--color-rust);font-family:var(--font-display);font-size:var(--step-2);font-weight:700}.intake .surface{padding:var(--space-6)}.quick-help{padding-block:var(--space-7) 0}.quick-help .surface{padding:var(--space-6)}.quick-help h2{max-width:24ch}.service-grid .text-link{display:inline-block;margin-top:var(--space-2)}@media(min-width:48rem){.service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.work-grid{grid-template-columns:repeat(3,minmax(0,1fr));align-items:start}.work-grid>:nth-child(2){margin-top:var(--space-6)}}@media(min-width:64rem){.hero{grid-template-columns:minmax(0,1fr) minmax(28rem,.86fr)}}@media(max-width:28rem){.actions>:global(*){width:100%}.board{min-height:32rem}}</style>
