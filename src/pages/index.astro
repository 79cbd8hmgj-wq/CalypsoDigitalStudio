---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {services} from '../data/services';
import {processSteps} from '../data/process';
const projectOrder=new Map([['lrl-photography',0],['rare-treats-518',1],['good-intentions',2]]);
const projects=(await getCollection('projects')).filter((p)=>p.data.featured).sort((a,b)=>(projectOrder.get(a.data.slug)??99)-(projectOrder.get(b.data.slug)??99));
---
<BaseLayout title="Calypso Digital Studio" description="Custom websites and practical digital tools for small businesses, independent professionals, and growing brands."><section class="hero container"><div><p class="eyebrow">Web design and custom development</p><h1>Websites and digital tools built around the way your business works.</h1><p class="lede">Calypso Digital Studio designs custom websites and practical software for small businesses, independent professionals, and growing brands.</p><div class="actions"><ButtonLink href="/start">Start Your Project</ButtonLink><ButtonLink href="/work" variant="secondary">View Selected Work</ButtonLink></div></div><div class="board" aria-label="Selected Calypso Digital Studio projects"><figure class="shot one"><img src="/assets/projects/lrl-photography/portfolio-mobile.webp" alt="LRL Photography portfolio page preview" width="1242" height="2250"/><figcaption>Service website</figcaption></figure><figure class="shot two"><img src="/assets/projects/rare-treats-518/home-mobile.webp" alt="Rare Treats 518 homepage preview" width="1242" height="2250"/><figcaption>Consumer brand</figcaption></figure><div class="tool"><strong>Custom tools</strong><span>Dashboards, workflows, forms, and purpose-built software.</span></div></div></section><section class="services container"><p class="eyebrow">What the studio builds</p><h2>Clear websites first. Custom functionality when the business needs it.</h2><div class="service-grid">{services.slice(0,4).map((s,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{s.title}</h3><p>{s.summary}</p></article>)}</div></section><section class="work container"><p class="eyebrow">Selected work</p><h2>Different businesses should not all look like the same template.</h2><div class="work-grid">{projects.map((p)=><ProjectCard title={p.data.title} summary={p.data.summary} projectType={p.data.projectType} status={p.data.status} image={p.data.primaryImage}/>)}</div><p><a class="text-link" href="/work">See the full project overview</a></p></section><section class="tools"><div class="container"><p class="eyebrow">Beyond the website</p><h2>When an ordinary website cannot solve the whole problem.</h2><p>The studio also builds practical digital tools for booking, client intake, customer workflows, calculations, dashboards, and internal processes.</p><a class="text-link" href="/services#custom-tools">Explore custom business tools</a></div></section><section class="process container"><p class="eyebrow">How projects move</p><h2>A clear process from the first inquiry through launch.</h2><ol>{processSteps.slice(0,4).map(([title,description],i)=><li><span>{i+1}</span><div><h3>{title}</h3><p>{description}</p></div></li>)}</ol><a class="text-link" href="/process">See the complete process</a></section><section class="intake container"><div class="surface"><p class="eyebrow">Start with what you know</p><h2>You can begin without planning every part of the website.</h2><p>The guided project form organizes the business, goals, features, and available materials into clear steps.</p><ButtonLink href="/start">Start Your Project</ButtonLink></div></section></BaseLayout>
<style>.hero{display:grid;gap:var(--space-7);align-items:center;padding-block:var(--space-8)}.lede{font-size:var(--step-1)}.actions{display:flex;flex-wrap:wrap;gap:var(--space-3);margin-top:var(--space-5)}.board{position:relative;min-height:37rem;border:var(--border-thin);border-radius:var(--radius-large);background:linear-gradient(135deg,rgb(229 178 158 / .75),rgb(216 214 234 / .72));overflow:hidden}.shot{position:absolute;width:min(56%,15rem);margin:0;overflow:hidden;border:.5rem solid var(--color-surface);border-radius:var(--radius-medium);background:var(--color-surface);box-shadow:var(--shadow-soft)}.shot img{aspect-ratio:.62;width:100%;object-fit:cover;object-position:top}.shot figcaption{padding:.55rem .7rem;font-size:var(--step--1);font-weight:800}.one{top:2rem;left:1.5rem;transform:rotate(-3deg)}.two{top:6rem;right:1.25rem;transform:rotate(3deg)}.tool{position:absolute;right:1.5rem;bottom:1.5rem;left:1.5rem;display:grid;gap:.25rem;border-radius:var(--radius-small);background:var(--color-ink);color:var(--color-canvas);padding:var(--space-4)}.services,.work,.process,.intake{padding-block:var(--space-8)}.service-grid,.work-grid{display:grid;gap:var(--space-4)}.service-grid article{border-top:2px solid var(--color-ink);padding-block:var(--space-5)}.service-grid span{color:var(--color-rust);font-weight:800}.tools{background:var(--color-ink);color:var(--color-canvas)}.tools .container{padding-block:var(--space-8)}.tools .eyebrow{color:var(--color-clay)}.process ol{margin:0 0 var(--space-5);padding:0;list-style:none}.process li{display:grid;grid-template-columns:2.5rem 1fr;gap:var(--space-4);border-top:var(--border-thin);padding-block:var(--space-5)}.process li>span{color:var(--color-rust);font-family:var(--font-display);font-size:var(--step-2);font-weight:700}.intake .surface{padding:var(--space-6)}@media(min-width:48rem){.service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.work-grid{grid-template-columns:repeat(3,minmax(0,1fr));align-items:start}.work-grid>:nth-child(2){margin-top:var(--space-6)}}@media(min-width:64rem){.hero{grid-template-columns:minmax(0,1fr) minmax(28rem,.86fr)}}@media(max-width:28rem){.actions>:global(*){width:100%}.board{min-height:32rem}}</style>
